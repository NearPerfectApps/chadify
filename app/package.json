{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "npx convex dev & expo start --dev-client --clear",
    "start": "expo start -c --go",
    "convex": "npx convex dev",
    "build:sim": "eas build --profile development-simulator --platform ios",
    "build:dev": "eas build --profile development --platform ios",
    "build:staging": "eas build --profile staging --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "submit:prod": "eas submit --profile production --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "iphone": "expo run:ios --device",
    "iphone:rebuild": "expo prebuild --clean && sed -i '' 's/CODE_SIGN_STYLE = Manual/CODE_SIGN_STYLE = Automatic/g' ios/Chadify.xcodeproj/project.pbxproj && expo run:ios --device",
    "web": "expo start --web"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "convex": "^1.34.0",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.9",
    "expo-audio": "~55.0.9",
    "expo-auth-session": "~55.0.10",
    "expo-camera": "~55.0.11",
    "expo-crypto": "~55.0.10",
    "expo-dev-client": "~55.0.19",
    "expo-file-system": "~55.0.12",
    "expo-image-picker": "~55.0.14",
    "expo-media-library": "~55.0.10",
    "expo-secure-store": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-purchases": "^9.14.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
